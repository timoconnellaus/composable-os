{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": ["./packages/config/biome-preset.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/worker-configuration.d.ts",
      "!**/routeTree.gen.ts",
      "!**/account-sections.gen.ts",
      "!**/.wrangler",
      "!**/dist",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.md",
      "!.kim",
      "!.claude/skills/landing-page-generator",
      "!docs/stages/assets",
      "!scripts/release/test/testdata",
      "!packages/client/test/generated",
      "!templates/client/apps/web/src/client",
      "!templates/client/apps/mobile/src/client",
      "!blocks/ui-*",
      "!evals/*/recordings",
      "!packages/gatekeeper-interface/src",
      "!packages/gatekeeper-interface/testing",
      "!packages/gatekeeper-observability/src",
      "!packages/gatekeeper-observability/__tests__",
      "!packages/gatekeeper-configurator-ui/src",
      "!packages/gatekeeper-kit/src",
      "!packages/gatekeeper-kit/__tests__",
      "!packages/mcp-shared/src",
      "!packages/mcp-shared/__tests__",
      "!packages/gatekeeper-mcp/src",
      "!packages/gatekeeper-mcp/__tests__",
      "!packages/gatekeeper-google/src",
      "!packages/gatekeeper-google/__tests__",
      "!packages/gatekeeper-microsoft/src",
      "!packages/gatekeeper-microsoft/__tests__",
      "!packages/gatekeeper-slack/src",
      "!packages/gatekeeper-email/src",
      "!packages/gatekeeper-zoominfo/src",
      "!packages/gatekeeper-websearch/src",
      "!packages/gatekeeper-websearch/__tests__"
    ]
  },
  "overrides": [
    {
      "includes": [
        "blocks/web-*/**",
        "packs/ticketing/blocks/ticketing-events/**",
        "packs/ticketing/blocks/ticketing-checkout/**",
        "packs/ticketing/blocks/ticketing-order/**",
        "packs/ticketing/blocks/ticketing-my-tickets/**",
        "packs/programs/blocks/programs-builder/**",
        "packs/programs/blocks/programs-bank/**",
        "packs/programs/blocks/programs-session/**",
        "packs/programs/blocks/programs-today/**",
        "packs/programs/blocks/programs-class-today/**",
        "packs/programs/blocks/programs-progress/**",
        "packs/programs/blocks/programs-coach-client/**",
        "packs/programs/blocks/programs-history/**",
        "packs/content/blocks/content-rich-text/**",
        "packs/content/blocks/content-post/**",
        "packs/content/blocks/content-post-list/**",
        "packs/courses/blocks/courses-catalogue/**",
        "packs/courses/blocks/courses-course/**",
        "packs/courses/blocks/courses-player/**",
        "packs/courses/blocks/courses-my-courses/**",
        "packs/courses/blocks/courses-builder/**",
        "packs/courses/blocks/courses-subscribe/**",
        "packs/courses/blocks/courses-subscription/**",
        "packs/bookings/blocks/bookings-timetable/**",
        "packs/bookings/blocks/bookings-desk/**",
        "packs/bookings/blocks/bookings-class-list/**",
        "packs/bookings/blocks/bookings-drop-in/**",
        "packs/memberships/blocks/memberships-plans/**",
        "packs/memberships/blocks/memberships-passes/**",
        "packs/memberships/blocks/memberships-mine/**",
        "packs/memberships/blocks/memberships-staff-holdings/**",
        "packs/rostering/blocks/rostering-week/**",
        "packs/rostering/blocks/rostering-my-shifts/**",
        "packs/rostering/blocks/rostering-offers/**",
        "packs/rostering/blocks/rostering-my-availability/**",
        "packs/rostering/blocks/rostering-patterns/**",
        "packs/rostering/blocks/rostering-qualifications/**",
        "packs/rostering/blocks/rostering-away/**",
        "packs/rostering/blocks/rostering-pay/**",
        "packs/rostering/blocks/rostering-my-calendar/**",
        "packs/rostering/blocks/rostering-checklist/**",
        "packs/rostering/blocks/rostering-checklists/**",
        "packs/dailychecks/blocks/dailychecks-today/**",
        "packs/dailychecks/blocks/dailychecks-history/**",
        "packs/forms/blocks/forms-form/**",
        "packs/knowledge/blocks/knowledge-procedures/**",
        "packs/knowledge/blocks/knowledge-to-read/**",
        "packs/knowledge/blocks/knowledge-read-status/**",
        "packs/knowledge/blocks/knowledge-help-centre/**",
        "packs/knowledge/blocks/knowledge-help-page/**",
        "apps/screens/src/**",
        "apps/screens/previews/**"
      ],
      "linter": { "rules": { "correctness": { "noReactNativeRawText": "off" } } }
    },
    {
      "includes": ["packages/agent-*/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@composable-os/*",
                      "!@composable-os/agent-*",
                      "!@composable-os/config/*"
                    ],
                    "message": "agent-* packages are MIT and import no CRM code (ADR 0350). Inject what you need instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/components/**", "packages/ui/src/hooks/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDocumentCookie": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/marketing/src/styles/**"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
