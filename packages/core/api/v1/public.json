{
  "version": "v1",
  "operations": [
    {
      "name": "capacity.get",
      "description": "How many places a record of an object with a capacity has left (a ticket type, a class). Staff get places, held (while someone pays), taken (paid), available, and the pool's numbers when the record draws on a parent's places. Customers and the public get only what the object shows: the number left, a low-stock warning, or available / sold out. Read-only; claims nothing.",
      "risk": "read",
      "audiences": ["public"],
      "kind": "query",
      "input": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "An extension object that declares a capacity"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": ["object", "id"]
      },
      "output": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["available", "low", "sold_out"],
            "description": "`low` only when the object shows a low-stock warning and few are left"
          },
          "available": {
            "description": "Places left; null when unlimited. Shown to outsiders only when `show` allows",
            "type": ["number", "null"]
          },
          "places": {
            "type": ["number", "null"]
          },
          "held": {
            "type": "number"
          },
          "taken": {
            "type": "number"
          },
          "show": {
            "type": "string",
            "enum": ["exact", "low", "availability"]
          },
          "lowAt": {
            "type": ["number", "null"]
          },
          "pool": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "object": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "places": {
                    "type": ["number", "null"]
                  },
                  "held": {
                    "type": "number"
                  },
                  "taken": {
                    "type": "number"
                  },
                  "available": {
                    "type": ["number", "null"]
                  }
                },
                "required": ["object", "id", "places", "held", "taken", "available"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["object", "id", "status"],
        "additionalProperties": false
      },
      "invalidates": []
    },
    {
      "name": "order.checkout",
      "description": "Open the payment provider's own page to pay for an order, and get its address to send the buyer to. The host says what is charged: the whole price or the deposit for an order with nothing paid (no amount may be given), or, for a part-paid order, the balance or a part of it of at least the set minimum (`amount`, in the currency's minor unit). The buyer comes back to `returnUrl`, which must be on one of the deployment's listed sites; coming back does not mark anything paid. Only the provider's confirmation does. A guest passes the order's token; a signed-in customer pays their own orders.",
      "risk": "write",
      "audiences": ["public"],
      "kind": "mutation",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Order id (ord_…)"
          },
          "token": {
            "description": "A guest's token for the order",
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "returnUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Where the buyer comes back to"
          },
          "amount": {
            "description": "Part-paid orders only: how much to pay towards the balance, in minor units",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["id", "returnUrl"]
      },
      "output": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The provider's payment page"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["full", "deposit", "balance", "part"]
          },
          "expiresAt": {
            "type": ["string", "null"]
          }
        },
        "required": ["url", "amount", "currency", "kind", "expiresAt"],
        "additionalProperties": false
      },
      "invalidates": ["order.view"]
    },
    {
      "name": "order.start",
      "description": "Start an order for one or more records that are for sale, as a signed-in customer, a guest (with an email address) or staff. The host prices it from the records: a caller never sends a price or a total. The order starts pending and is not paid: paying happens on the payment provider's page (order.checkout), and only the provider's confirmation marks it paid. An unpaid order expires after a few minutes. Returns the order with its lines and amounts in the currency's minor unit; a guest also gets `token`, shown once, which is the only way back to the order (order.view).",
      "risk": "write",
      "audiences": ["public"],
      "kind": "mutation",
      "input": {
        "type": "object",
        "properties": {
          "lines": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "object": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "The object of the record to buy"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "description": "The record to buy"
                },
                "quantity": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                }
              },
              "required": ["object", "id"]
            },
            "description": "What to buy. There is no price here: the host reads it from each record, and a price or total sent anyway is ignored."
          },
          "pay": {
            "default": "full",
            "description": "full: pay the whole price now. deposit: pay the deposit now and the balance by its due date, when every line offers a deposit.",
            "type": "string",
            "enum": ["full", "deposit"]
          },
          "email": {
            "description": "The buyer's email address. Required when the caller is not a signed-in customer; a signed-in customer's order uses their account's address and must not pass one.",
            "type": "string",
            "maxLength": 320
          }
        },
        "required": ["lines"]
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["pending", "part_paid", "paid", "cancelled", "expired", "refunded"]
          },
          "currency": {
            "type": "string"
          },
          "total": {
            "type": "number"
          },
          "paid": {
            "type": "number"
          },
          "balance": {
            "type": "number"
          },
          "refunded": {
            "type": "number",
            "description": "What has gone back to the buyer, confirmed by the provider"
          },
          "pay": {
            "type": "string",
            "enum": ["full", "deposit"]
          },
          "deposit": {
            "type": ["number", "null"]
          },
          "balanceDueAt": {
            "type": ["string", "null"]
          },
          "expiresAt": {
            "type": ["string", "null"]
          },
          "paidAt": {
            "type": ["string", "null"]
          },
          "createdAt": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "position": {
                  "type": "number"
                },
                "object": {
                  "type": "string"
                },
                "recordId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "unitPrice": {
                  "type": "number"
                },
                "total": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "position",
                "object",
                "recordId",
                "title",
                "quantity",
                "unitPrice",
                "total"
              ],
              "additionalProperties": false
            }
          },
          "personId": {
            "type": ["string", "null"]
          },
          "email": {
            "type": ["string", "null"]
          },
          "placedAs": {
            "type": "string",
            "enum": ["customer", "public", "staff"]
          },
          "token": {
            "description": "A guest's key to this order. Null for everyone else.",
            "type": ["string", "null"]
          }
        },
        "required": [
          "id",
          "state",
          "currency",
          "total",
          "paid",
          "balance",
          "refunded",
          "pay",
          "deposit",
          "balanceDueAt",
          "expiresAt",
          "paidAt",
          "createdAt",
          "lines",
          "token"
        ],
        "additionalProperties": false
      },
      "invalidates": ["order.view"]
    },
    {
      "name": "order.view",
      "description": "See one order with the token it was started with (a guest's link from order.start or the confirmation email). The token opens that order only, while it is open and for 30 days after it closes. A wrong id, a wrong token and an old link are all not found. Read-only.",
      "risk": "read",
      "audiences": ["public"],
      "kind": "query",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Order id (ord_…)"
          },
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "The order's token"
          }
        },
        "required": ["id", "token"]
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["pending", "part_paid", "paid", "cancelled", "expired", "refunded"]
          },
          "currency": {
            "type": "string"
          },
          "total": {
            "type": "number"
          },
          "paid": {
            "type": "number"
          },
          "balance": {
            "type": "number"
          },
          "refunded": {
            "type": "number",
            "description": "What has gone back to the buyer, confirmed by the provider"
          },
          "pay": {
            "type": "string",
            "enum": ["full", "deposit"]
          },
          "deposit": {
            "type": ["number", "null"]
          },
          "balanceDueAt": {
            "type": ["string", "null"]
          },
          "expiresAt": {
            "type": ["string", "null"]
          },
          "paidAt": {
            "type": ["string", "null"]
          },
          "createdAt": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "position": {
                  "type": "number"
                },
                "object": {
                  "type": "string"
                },
                "recordId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "unitPrice": {
                  "type": "number"
                },
                "total": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "position",
                "object",
                "recordId",
                "title",
                "quantity",
                "unitPrice",
                "total"
              ],
              "additionalProperties": false
            }
          },
          "personId": {
            "type": ["string", "null"]
          },
          "email": {
            "type": ["string", "null"]
          },
          "placedAs": {
            "type": "string",
            "enum": ["customer", "public", "staff"]
          }
        },
        "required": [
          "id",
          "state",
          "currency",
          "total",
          "paid",
          "balance",
          "refunded",
          "pay",
          "deposit",
          "balanceDueAt",
          "expiresAt",
          "paidAt",
          "createdAt",
          "lines"
        ],
        "additionalProperties": false
      },
      "invalidates": []
    },
    {
      "name": "x.ticketing.eventsOnSale",
      "description": "The events on sale now, soonest first, each with its ticket types (name, price, sale window, most per order, deposit) and whether places are left. For an event page or a list of events. Only what the public may read: an event that is not on sale is not here. Read-only. (Extension tool from Ticketing 0.1.0.)",
      "risk": "read",
      "audiences": ["public"],
      "kind": "query",
      "input": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Only this event"
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": ["string", "null"]
                },
                "startsAt": {
                  "type": ["string", "null"]
                },
                "endsAt": {
                  "type": ["string", "null"]
                },
                "venue": {
                  "type": ["string", "null"]
                },
                "description": {
                  "type": ["string", "null"]
                },
                "image": {
                  "type": ["string", "null"]
                },
                "availability": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["available", "low", "sold_out"]
                    },
                    "available": {
                      "description": "Places left, when the type says so",
                      "type": ["number", "null"]
                    }
                  },
                  "required": ["status"],
                  "additionalProperties": false
                },
                "ticketTypes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": ["string", "null"]
                      },
                      "description": {
                        "type": ["string", "null"]
                      },
                      "price": {
                        "type": ["number", "null"]
                      },
                      "onSaleFrom": {
                        "type": ["string", "null"]
                      },
                      "onSaleUntil": {
                        "type": ["string", "null"]
                      },
                      "maxPerOrder": {
                        "type": ["number", "null"]
                      },
                      "deposit": {
                        "type": ["number", "null"]
                      },
                      "balanceDue": {
                        "type": ["string", "null"]
                      },
                      "availability": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": ["available", "low", "sold_out"]
                          },
                          "available": {
                            "description": "Places left, when the type says so",
                            "type": ["number", "null"]
                          }
                        },
                        "required": ["status"],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "description",
                      "price",
                      "onSaleFrom",
                      "onSaleUntil",
                      "maxPerOrder",
                      "deposit",
                      "balanceDue",
                      "availability"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "name",
                "startsAt",
                "endsAt",
                "venue",
                "description",
                "image",
                "availability",
                "ticketTypes"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["events"],
        "additionalProperties": false
      },
      "invalidates": [],
      "pack": "ticketing"
    },
    {
      "name": "x.ticketing.orderStart",
      "description": "Start an order for tickets: one or more ticket types and how many of each, paid in full or by deposit when every ticket type offers one. A signed-in customer buys as themselves; a guest gives their email address. The host prices the order from the ticket types, refuses a ticket type outside its sale window, over its most per order or without enough places left (with details naming the rule), and holds the places while the order is unpaid. Nothing is paid here: the buyer then calls order.checkout with the order's id (and a guest's token) to pay on the provider's page. Amounts are in the minor unit. (Extension tool from Ticketing 0.1.0.)",
      "risk": "write",
      "audiences": ["public"],
      "kind": "mutation",
      "input": {
        "type": "object",
        "properties": {
          "lines": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ticketTypeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "description": "The ticket type (its record id)"
                },
                "quantity": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "required": ["ticketTypeId"],
              "additionalProperties": {}
            }
          },
          "pay": {
            "default": "full",
            "type": "string",
            "enum": ["full", "deposit"]
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "description": "A guest's email address. A signed-in customer passes none."
          }
        },
        "required": ["lines"],
        "additionalProperties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "total": {
            "type": "number",
            "description": "In the currency's minor unit (cents)"
          },
          "paid": {
            "type": "number"
          },
          "balance": {
            "type": "number"
          },
          "pay": {
            "type": "string"
          },
          "deposit": {
            "type": ["number", "null"]
          },
          "balanceDueAt": {
            "type": ["string", "null"]
          },
          "expiresAt": {
            "type": ["string", "null"]
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "ticketTypeId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "unitPrice": {
                  "type": "number"
                },
                "total": {
                  "type": "number"
                }
              },
              "required": ["id", "ticketTypeId", "title", "quantity", "unitPrice", "total"],
              "additionalProperties": false
            }
          },
          "token": {
            "description": "A guest's key to this order, shown once (order.checkout and order.view take it)",
            "type": ["string", "null"]
          }
        },
        "required": [
          "id",
          "state",
          "currency",
          "total",
          "paid",
          "balance",
          "pay",
          "deposit",
          "balanceDueAt",
          "expiresAt",
          "lines",
          "token"
        ],
        "additionalProperties": false
      },
      "invalidates": ["x.ticketing.eventsOnSale"],
      "pack": "ticketing"
    }
  ]
}
