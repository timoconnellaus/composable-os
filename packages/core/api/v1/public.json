{
  "version": "v1",
  "operations": [
    {
      "name": "capacity.get",
      "description": "How many places a record of an object with a capacity has left (a ticket type, a class). Staff get places, held (while someone pays), taken (paid), available, and the pool's numbers when the record draws on a parent's places. Customers and the public get only what the object shows: the number left, a low-stock warning, or available / sold out. Read-only; claims nothing.",
      "risk": "read",
      "audiences": ["public"],
      "kind": "query",
      "input": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "An extension object that declares a capacity"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": ["object", "id"]
      },
      "output": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["available", "low", "sold_out"],
            "description": "`low` only when the object shows a low-stock warning and few are left"
          },
          "available": {
            "description": "Places left; null when unlimited. Shown to outsiders only when `show` allows",
            "type": ["number", "null"]
          },
          "places": {
            "type": ["number", "null"]
          },
          "held": {
            "type": "number"
          },
          "taken": {
            "type": "number"
          },
          "show": {
            "type": "string",
            "enum": ["exact", "low", "availability"]
          },
          "lowAt": {
            "type": ["number", "null"]
          },
          "pool": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "object": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "places": {
                    "type": ["number", "null"]
                  },
                  "held": {
                    "type": "number"
                  },
                  "taken": {
                    "type": "number"
                  },
                  "available": {
                    "type": ["number", "null"]
                  }
                },
                "required": ["object", "id", "places", "held", "taken", "available"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["object", "id", "status"],
        "additionalProperties": false
      },
      "invalidates": []
    },
    {
      "name": "content.get",
      "description": "Read one published record of a content object (a blog post) by its slug, as the public reads it: its published version, with only the fields the object lets the public read. An old slug of a record whose slug changed answers `redirect` with the slug it has now. A draft, an unpublished record and an unknown slug are all not found. Read-only.",
      "risk": "read",
      "audiences": ["public"],
      "kind": "query",
      "input": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "A publishable object the public reads, e.g. `content.post`"
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The record's address, e.g. `summer-launch`"
          }
        },
        "required": ["object", "slug"]
      },
      "output": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "object": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "kind": {
                "type": "string",
                "const": "record"
              }
            },
            "required": ["object", "id", "values", "kind"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "redirect"
              },
              "object": {
                "type": "string"
              },
              "slug": {
                "type": "string",
                "description": "Where the record is now: read it by this slug"
              }
            },
            "required": ["kind", "object", "slug"],
            "additionalProperties": false
          }
        ]
      },
      "invalidates": []
    },
    {
      "name": "content.list",
      "description": "A page of the published records of a content object (blog posts), as the public reads them: published versions only, with only the fields the object lets the public read. Newest first by default (the object's date, else when each was published). Filter and sort on those fields; pass nextCursor back as cursor. Read-only.",
      "risk": "read",
      "audiences": ["public"],
      "kind": "query",
      "input": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "A publishable object the public reads, e.g. `content.post`"
          },
          "filter": {
            "$ref": "#/$defs/__schema0"
          },
          "sort": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "direction": {
                "default": "asc",
                "type": "string",
                "enum": ["asc", "desc"]
              }
            },
            "required": ["field"]
          },
          "cursor": {
            "type": "string",
            "maxLength": 1000
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": ["object"],
        "$defs": {
          "__schema0": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "op": {
                    "type": "string",
                    "enum": [
                      "eq",
                      "neq",
                      "lt",
                      "lte",
                      "gt",
                      "gte",
                      "between",
                      "in",
                      "not_in",
                      "contains",
                      "not_contains",
                      "starts_with",
                      "ends_with",
                      "is_null",
                      "is_not_null"
                    ]
                  },
                  "value": {}
                },
                "required": ["field", "op"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "and": {
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/__schema0"
                    }
                  }
                },
                "required": ["and"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "or": {
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/__schema0"
                    }
                  }
                },
                "required": ["or"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "object": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "values": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": ["object", "id", "values"],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        },
        "required": ["items", "nextCursor"],
        "additionalProperties": false
      },
      "invalidates": []
    },
    {
      "name": "content.preview",
      "description": "Read the working copy of one record of a content object with a preview link's token: what staff are editing, before it is published, with only the fields the public would read. The token names one record and works until it expires; for any other record, or after, it is not found. Read-only.",
      "risk": "read",
      "audiences": ["public"],
      "kind": "query",
      "input": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "A publishable object the public reads, e.g. `content.post`"
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The record's address, e.g. `summer-launch`"
          },
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "The token of a preview link"
          }
        },
        "required": ["object", "slug", "token"]
      },
      "output": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "kind": {
            "type": "string",
            "const": "preview"
          }
        },
        "required": ["object", "id", "values", "kind"],
        "additionalProperties": false
      },
      "invalidates": []
    },
    {
      "name": "media.play",
      "description": "A short-lived token to play one ready video, and where it plays (HLS, DASH, Stream's player), signed by the host: staff may play any; a customer or the public only a video that a published record they may read shows, in a part they may read (a lesson's video only for a holder of access to its course, a trailer for anyone). Anything else, and a made-up id, is not found. The token is for this video only, lives at most an hour, and never allows a download. Read-only.",
      "risk": "read",
      "audiences": ["public"],
      "kind": "query",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "A media item's id"
          },
          "record": {
            "description": "The record that shows it, to look only there",
            "type": "object",
            "properties": {
              "object": {
                "type": "string",
                "maxLength": 81
              },
              "id": {
                "type": "string",
                "maxLength": 64
              }
            },
            "required": ["object", "id"]
          },
          "field": {
            "description": "The field of that record that shows it",
            "type": "string",
            "maxLength": 40
          },
          "purpose": {
            "default": "stream",
            "description": "stream: to watch. (A download for offline viewing is not offered yet.)",
            "type": "string",
            "enum": ["stream"]
          },
          "seconds": {
            "description": "How long the token lives; at most, and by default, an hour",
            "type": "integer",
            "minimum": 60,
            "maximum": 3600
          }
        },
        "required": ["id"]
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "hls": {
            "type": "string"
          },
          "dash": {
            "type": "string"
          },
          "iframe": {
            "type": "string"
          },
          "poster": {
            "type": "string",
            "description": "The poster frame Stream made, with the token"
          },
          "duration": {
            "type": ["number", "null"]
          },
          "captions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "language": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": ["language", "label"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "token",
          "expiresAt",
          "hls",
          "dash",
          "iframe",
          "poster",
          "duration",
          "captions"
        ],
        "additionalProperties": false
      },
      "invalidates": []
    },
    {
      "name": "media.serve",
      "description": "Whether the caller may be served one picture or downloadable file, and at what width: staff any live one; a customer or the public only one that a published record they may read shows in a part they may read. Anything else is not found, and so is a video (it plays with media.play). The media route (`/api/media/<id>`) streams it. Read-only.",
      "risk": "read",
      "audiences": ["public"],
      "kind": "query",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "A media item's id"
          },
          "width": {
            "description": "The width asked for",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": ["id"]
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "width": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "The width to serve; null for the original"
          },
          "public": {
            "type": "boolean",
            "description": "Served because published content shows it"
          }
        },
        "required": ["id", "key", "type", "bytes", "width", "public"],
        "additionalProperties": false
      },
      "invalidates": []
    },
    {
      "name": "order.checkout",
      "description": "Open the payment provider's own page to pay for an order, and get its address to send the buyer to. The host says what is charged: the whole price or the deposit for an order with nothing paid (no amount may be given), or, for a part-paid order, the balance or a part of it of at least the set minimum (`amount`, in the currency's minor unit). The buyer comes back to `returnUrl`, which must be on one of the deployment's listed sites; coming back does not mark anything paid. Only the provider's confirmation does. A guest passes the order's token; a signed-in customer pays their own orders.",
      "risk": "write",
      "audiences": ["public"],
      "kind": "mutation",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Order id (ord_…)"
          },
          "token": {
            "description": "A guest's token for the order",
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "returnUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Where the buyer comes back to"
          },
          "amount": {
            "description": "Part-paid orders only: how much to pay towards the balance, in minor units",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["id", "returnUrl"]
      },
      "output": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The provider's payment page"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["full", "deposit", "balance", "part"]
          },
          "expiresAt": {
            "type": ["string", "null"]
          }
        },
        "required": ["url", "amount", "currency", "kind", "expiresAt"],
        "additionalProperties": false
      },
      "invalidates": ["order.view"]
    },
    {
      "name": "order.start",
      "description": "Start an order for one or more records that are for sale, as a signed-in customer, a guest (with an email address) or staff. The host prices it from the records: a caller never sends a price or a total. The order starts pending and is not paid: paying happens on the payment provider's page (order.checkout), and only the provider's confirmation marks it paid. An unpaid order expires after a few minutes. Returns the order with its lines and amounts in the currency's minor unit; a guest also gets `token`, shown once, which is the only way back to the order (order.view).",
      "risk": "write",
      "audiences": ["public"],
      "kind": "mutation",
      "input": {
        "type": "object",
        "properties": {
          "lines": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "object": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "The object of the record to buy"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "description": "The record to buy"
                },
                "quantity": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                }
              },
              "required": ["object", "id"]
            },
            "description": "What to buy. There is no price here: the host reads it from each record, and a price or total sent anyway is ignored."
          },
          "pay": {
            "default": "full",
            "description": "full: pay the whole price now. deposit: pay the deposit now and the balance by its due date, when every line offers a deposit.",
            "type": "string",
            "enum": ["full", "deposit"]
          },
          "email": {
            "description": "The buyer's email address. Required when the caller is not a signed-in customer; a signed-in customer's order uses their account's address and must not pass one.",
            "type": "string",
            "maxLength": 320
          }
        },
        "required": ["lines"]
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["pending", "part_paid", "paid", "cancelled", "expired", "refunded"]
          },
          "currency": {
            "type": "string"
          },
          "total": {
            "type": "number"
          },
          "paid": {
            "type": "number"
          },
          "balance": {
            "type": "number"
          },
          "refunded": {
            "type": "number",
            "description": "What has gone back to the buyer, confirmed by the provider"
          },
          "pay": {
            "type": "string",
            "enum": ["full", "deposit"]
          },
          "deposit": {
            "type": ["number", "null"]
          },
          "balanceDueAt": {
            "type": ["string", "null"]
          },
          "expiresAt": {
            "type": ["string", "null"]
          },
          "paidAt": {
            "type": ["string", "null"]
          },
          "createdAt": {
            "type": "string"
          },
          "taxAmount": {
            "type": "number",
            "description": "The tax inside what has been paid, as the payment provider calculated it. Prices include it, so it does not add to the total. Zero when tax is off or none was charged."
          },
          "taxRefunded": {
            "type": "number",
            "description": "The tax the provider said went back with refunds"
          },
          "taxCountry": {
            "description": "The country the latest taxed payment was for",
            "type": ["string", "null"]
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "position": {
                  "type": "number"
                },
                "object": {
                  "type": "string"
                },
                "recordId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "unitPrice": {
                  "type": "number"
                },
                "total": {
                  "type": "number"
                },
                "taxAmount": {
                  "type": "number",
                  "description": "The tax inside this line's payments, as the payment provider calculated it"
                }
              },
              "required": [
                "id",
                "position",
                "object",
                "recordId",
                "title",
                "quantity",
                "unitPrice",
                "total",
                "taxAmount"
              ],
              "additionalProperties": false
            }
          },
          "personId": {
            "type": ["string", "null"]
          },
          "email": {
            "type": ["string", "null"]
          },
          "placedAs": {
            "type": "string",
            "enum": ["customer", "public", "staff"]
          },
          "token": {
            "description": "A guest's key to this order. Null for everyone else.",
            "type": ["string", "null"]
          }
        },
        "required": [
          "id",
          "state",
          "currency",
          "total",
          "paid",
          "balance",
          "refunded",
          "pay",
          "deposit",
          "balanceDueAt",
          "expiresAt",
          "paidAt",
          "createdAt",
          "taxAmount",
          "taxRefunded",
          "taxCountry",
          "lines",
          "token"
        ],
        "additionalProperties": false
      },
      "invalidates": ["order.view"]
    },
