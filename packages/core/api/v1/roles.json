{
  "version": "v1",
  "roles": [
    {
      "name": "bookings.coach",
      "pack": "bookings",
      "label": "Coach",
      "description": "Sees the day's classes and each class's list, and ticks who came (or marks who did not). Nothing else: no money, no other people, no booking or cancelling, no settings.",
      "read": ["bookings.class"],
      "operations": [
        "ack.confirm",
        "ack.mine",
        "content.search",
        "content.staffGet",
        "content.staffList",
        "record.get",
        "record.list",
        "screens.mine",
        "x.bookings.day",
        "x.bookings.markAll",
        "x.bookings.markAttended",
        "x.bookings.markNoShow",
        "x.bookings.roster",
        "x.bookings.undoAttended",
        "x.dailychecks.day",
        "x.dailychecks.done",
        "x.dailychecks.tick",
        "x.dailychecks.today"
      ]
    },
    {
      "name": "programs.coach",
      "pack": "programs",
      "label": "Coach",
      "description": "Sees the clients they coach (an active program naming them their coach): their sessions, sets, history and progress, and logs sets and marks sessions for them. Nothing else: no other clients, no class sessions, no programs, no assigning, no people.",
      "read": ["programs.assignment", "programs.session"],
      "operations": [
        "ack.confirm",
        "ack.mine",
        "content.search",
        "content.staffGet",
        "content.staffList",
        "record.get",
        "record.list",
        "screens.mine",
        "x.dailychecks.day",
        "x.dailychecks.done",
        "x.dailychecks.tick",
        "x.dailychecks.today",
        "x.programs.history",
        "x.programs.logAdd",
        "x.programs.logRemove",
        "x.programs.logUpdate",
        "x.programs.progress",
        "x.programs.sessionComplete",
        "x.programs.sessionGet",
        "x.programs.today"
      ]
    },
    {
      "name": "rostering.team",
      "pack": "rostering",
      "label": "Rostered team",
      "description": "Sees the roster and their own shifts, offers and takes shifts, says when they are away, has their own calendar feed and sees their own hours for each pay period. Nothing else: no records, no people, no settings.",
      "read": [],
      "operations": [
        "ack.confirm",
        "ack.mine",
        "content.search",
        "content.staffGet",
        "content.staffList",
        "screens.mine",
        "x.dailychecks.day",
        "x.dailychecks.done",
        "x.dailychecks.tick",
        "x.dailychecks.today",
        "x.rostering.away",
        "x.rostering.back",
        "x.rostering.checklist",
        "x.rostering.checklistDone",
        "x.rostering.feed",
        "x.rostering.feedRevoke",
        "x.rostering.feedRotate",
        "x.rostering.me",
        "x.rostering.mine",
        "x.rostering.myAway",
        "x.rostering.myPay",
        "x.rostering.myPayPeriods",
        "x.rostering.offer",
        "x.rostering.offers",
        "x.rostering.take",
        "x.rostering.tick",
        "x.rostering.week",
        "x.rostering.withdraw"
      ]
    },
    {
      "name": "ticketing.door",
      "pack": "ticketing",
      "label": "Door",
      "description": "Checks tickets in at the door and sees events, ticket types and tickets. Nothing else: no people, orders, leads or settings.",
      "read": ["ticketing.event", "ticketing.ticket", "ticketing.tickettype"],
      "operations": [
        "ack.confirm",
        "ack.mine",
        "content.search",
        "content.staffGet",
        "content.staffList",
        "record.get",
        "record.list",
        "screens.mine",
        "x.dailychecks.day",
        "x.dailychecks.done",
        "x.dailychecks.tick",
        "x.dailychecks.today",
        "x.ticketing.checkIn",
        "x.ticketing.undoCheckIn"
      ]
    }
  ],
  "grants": [
    {
      "permission": "bookings:appointments",
      "pack": "bookings",
      "label": "Appointments: book one-to-one sessions for clients, move, cancel and mark them, give a session back, give a session to another coach, and see any coach's day. For a coach who manages the others' sessions.",
      "restricted": false,
      "operations": [
        "x.bookings.bookAppointment",
        "x.bookings.cancelAppointment",
        "x.bookings.cancelAppointmentByUs",
        "x.bookings.coachDay",
        "x.bookings.excuseAppointment",
        "x.bookings.markAppointment",
        "x.bookings.moveAppointment",
        "x.bookings.reassignAppointment"
      ]
    },
    {
      "permission": "bookings:desk",
      "pack": "bookings",
      "label": "Front desk: find people; book, cancel and move classes and one-to-one sessions for anyone; give a use back; mark sessions; see any day's classes and lists and every coach's day with its clients. For a coach who also works the desk.",
      "restricted": false,
      "operations": [
        "x.bookings.bookAppointment",
        "x.bookings.bookFor",
        "x.bookings.cancelAppointment",
        "x.bookings.cancelFor",
        "x.bookings.classList",
        "x.bookings.coachDay",
        "x.bookings.day",
        "x.bookings.excuseAppointment",
        "x.bookings.findPeople",
        "x.bookings.markAppointment",
        "x.bookings.move",
        "x.bookings.moveAppointment",
        "x.bookings.returnUse"
      ]
    },
    {
      "permission": "courses:enrol",
      "pack": "courses",
      "label": "courses:enrol",
      "restricted": false,
      "operations": ["x.courses.endEnrolment", "x.courses.enrol"]
    },
    {
      "permission": "memberships:passes",
      "pack": "memberships",
      "label": "memberships:passes",
      "restricted": false,
      "operations": ["x.memberships.givePass", "x.memberships.voidPass"]
    },
    {
      "permission": "rostering:manage",
      "pack": "rostering",
      "label": "Rostering, rosters others: put people on shifts, say who may do which work, record others' time off and see everyone's, see shifts with nobody on them, mark a shift not worked, and see how everyone's checklists went and tick one for someone. Admins hold it.",
      "restricted": true,
      "operations": [
        "x.rostering.assign",
        "x.rostering.awayFor",
        "x.rostering.awayList",
        "x.rostering.candidates",
        "x.rostering.check",
        "x.rostering.checklistCorrect",
        "x.rostering.checklistRuns",
        "x.rostering.follow",
        "x.rostering.markNotWorked",
        "x.rostering.patterns",
        "x.rostering.people",
        "x.rostering.planCheck",
        "x.rostering.qualifications",
        "x.rostering.qualify",
        "x.rostering.setPattern",
        "x.rostering.uncovered"
      ]
    },
    {
      "permission": "rostering:pay",
      "pack": "rostering",
      "label": "Rostering, pay: say who is counted for pay, see each pay period's hours and shifts, lock, reopen and export them for payroll. No rates or money are held. Admins hold it.",
      "restricted": true,
      "operations": [
        "x.rostering.export",
        "x.rostering.lock",
        "x.rostering.payBases",
        "x.rostering.payBasis",
        "x.rostering.periodTotals",
        "x.rostering.periods",
        "x.rostering.reopen"
      ]
    },
    {
      "permission": "rostering:roster",
      "pack": "rostering",
      "label": "Rostering: see the roster and their own shifts, offer and take shifts, say when they are away, have their own calendar feed and see their own hours for each pay period. For a coach or anyone with another role who is rostered.",
      "restricted": false,
      "operations": [
        "x.rostering.away",
        "x.rostering.back",
        "x.rostering.checklist",
        "x.rostering.checklistDone",
        "x.rostering.feed",
        "x.rostering.feedRevoke",
        "x.rostering.feedRotate",
        "x.rostering.me",
        "x.rostering.mine",
        "x.rostering.myAway",
        "x.rostering.myPay",
        "x.rostering.myPayPeriods",
        "x.rostering.offer",
        "x.rostering.offers",
        "x.rostering.take",
        "x.rostering.tick",
        "x.rostering.week",
        "x.rostering.withdraw"
      ]
    }
  ],
  "requires": {
    "bookings": ["programs"],
    "courses": ["programs", "content"],
    "memberships": ["programs", "bookings"]
  },
  "owner": {
    "operations": [
      "approval.approve",
      "approval.get",
      "approval.list",
      "approval.reject",
      "notification.list",
      "notification.markRead",
