{
  "name": "@composable-os/gatekeeper-text",
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "description": "Gatekeeper Worker for text messages: sends the host's routine texts and checking codes through the business's own text provider account, and delivers verified receipts and STOP, START and HELP replies to the host.",
  "type": "module",
  "main": "./src/worker.ts",
  "exports": {
    ".": "./src/worker.ts",
    "./types": "./src/types.d.ts"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false --check && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@composable-os/gatekeeper-interface": "workspace:*",
    "@composable-os/gatekeeper-kit": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@composable-os/config": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
