{
  "name": "@composable-os/blocks",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The blocks a client app copies (stage 24, ADR 0424): the web base layer (ui-*, from packages/ui), the native base layer and sign-in in both skins. They ship inside the release; this package only type-checks them.",
