    "@composable-os/client": "workspace:*",
    "@tanstack/react-query": "5.105.3",
    "@types/react": "19.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "tailwind-merge": "3.7.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
