{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["COS_TEST_DB"],
  "globalPassThroughEnv": [
    "COS_AI",
    "COS_VECTORIZE_INDEX",
    "COS_AI_MODEL_ROLES",
    "COS_AI_GATEWAY_BYOK",
    "COS_AI_GATEWAY_ID",
    "COS_AI_GATEWAY_REST",
    "RELEVANCE_REAL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["WORKERS_CI_COMMIT_SHA", "GIT_COMMIT", "COS_WRANGLER_CONFIG", "COS_PRODUCT"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@composable-os/product#test": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packs/**",
        "$TURBO_ROOT$/blocks/**",
        "!$TURBO_ROOT$/packs/*/node_modules/**",
        "!$TURBO_ROOT$/packs/*/.turbo/**",
        "!$TURBO_ROOT$/blocks/node_modules/**",
        "!$TURBO_ROOT$/blocks/.turbo/**"
      ]
    },
    "@composable-os/runner#test": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packs/**",
        "$TURBO_ROOT$/blocks/**",
        "!$TURBO_ROOT$/packs/*/node_modules/**",
        "!$TURBO_ROOT$/packs/*/.turbo/**",
        "!$TURBO_ROOT$/blocks/node_modules/**",
        "!$TURBO_ROOT$/blocks/.turbo/**"
      ]
    },
    "@composable-os/core#test": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packs/**",
        "!$TURBO_ROOT$/packs/*/node_modules/**",
        "!$TURBO_ROOT$/packs/*/.turbo/**"
      ]
    },
    "@composable-os/db#test": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/app/worker-configuration.d.ts",
        "$TURBO_ROOT$/apps/runner/worker-configuration.d.ts",
        "$TURBO_ROOT$/apps/app/.dev.vars.example",
        "$TURBO_ROOT$/apps/runner/.dev.vars.example",
        "$TURBO_ROOT$/apps/app/deploy-inputs.json",
        "$TURBO_ROOT$/apps/runner/deploy-inputs.json",
        "$TURBO_ROOT$/apps/app/src/**",
        "$TURBO_ROOT$/apps/runner/src/**",
        "$TURBO_ROOT$/packages/auth/src/**",
        "$TURBO_ROOT$/packages/core/src/**"
      ]
    },
    "@composable-os/release-scripts#test": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packs/**",
        "$TURBO_ROOT$/blocks/**",
        "!$TURBO_ROOT$/packs/*/node_modules/**",
        "!$TURBO_ROOT$/packs/*/.turbo/**",
        "!$TURBO_ROOT$/blocks/node_modules/**",
        "!$TURBO_ROOT$/blocks/.turbo/**"
      ]
    },
    "types": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
