{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": [],
    "rootDirs": [".", "../../../blocks", "../../content/blocks"]
  },
  "include": [
    "knowledge-procedures/*.tsx",
    "knowledge-to-read/*.tsx",
    "knowledge-read-status/*.tsx",
    "knowledge-help-centre/*.tsx",
    "knowledge-help-page/*.tsx"
  ]
}
