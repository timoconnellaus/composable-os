{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["@cloudflare/vitest-plugin/types"],
    "paths": { "react-native": ["./react-native-shim.tsx"] },
    "rootDirs": ["../blocks", "../../../blocks", "../../content/blocks"]
  },
  "include": ["*.tsx"]
}
