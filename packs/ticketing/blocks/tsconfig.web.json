{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": [],
    "rootDirs": [".", "../../../blocks"]
  },
  "include": [
    "ticketing-events/*.tsx",
    "ticketing-checkout/*.tsx",
    "ticketing-order/*.tsx",
    "ticketing-my-tickets/*.tsx"
  ]
}
