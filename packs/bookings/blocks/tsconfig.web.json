{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": [],
    "rootDirs": [".", "../../../blocks"]
  },
  "include": [
    "bookings-timetable/*.tsx",
    "bookings-desk/*.tsx",
    "bookings-class-list/*.tsx",
    "bookings-drop-in/*.tsx"
  ]
}
