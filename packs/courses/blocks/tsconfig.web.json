{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": [],
    "rootDirs": [".", "../../../blocks"]
  },
  "include": [
    "courses-catalogue/*.tsx",
    "courses-course/*.tsx",
    "courses-player/*.tsx",
    "courses-my-courses/*.tsx",
    "courses-builder/*.tsx"
  ]
}
