// cos-app: TanStack Start UI and server functions (ADR 0004). Self-contained and account-agnostic:
// no account or resource IDs are committed (ADR 0012); wrangler provisions the D1 database by name
// on first deploy. Secrets are listed in .dev.vars.example and docs/deploying.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cos-app",
  // TanStack Start's entry plus a `scheduled` handler (src/server.ts).
  "main": "./src/server.ts",
  // Daily maintenance: Trash purge (ADR 0018), approvals, storage retention (ADR 0090). Every 10
  // minutes: the embedding catch-up for semantic search (ADR 0154; does nothing without AI).
  "triggers": { "crons": ["17 3 * * *", "*/10 * * * *"] },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cos",
      "migrations_dir": "../../packages/db/migrations",
      "migrations_table": "core_migrations"
    }
  ],
  // Secrets are set with `wrangler secret put` and never committed. Optional ones (BETTER_AUTH_URL,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, CF_ACCESS_TEAM_DOMAIN, CF_ACCESS_AUD) are listed in
  // .dev.vars.example and docs/deploying.md.
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  "services": [{ "binding": "RUNNER", "service": "cos-runner" }],
  // Automation events (ADR 0130): committed record changes and approval decisions go to this
  // queue; cos-runner consumes it and starts automation runs.
  "queues": {
    "producers": [{ "binding": "AUTOMATION_EVENTS", "queue": "cos-automation-events" }],
    // A routine's messages (ADR 0343): cos-runner produces them, and this Worker delivers each
    // into its owner's thread. cos-runner cannot bind back to cos-app (a cycle on first deploy).
    "consumers": [
      {
        "queue": "cos-routine-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "cos-routine-delivery-dlq"
      }
    ]
  },
  // Synced email bodies (ADR 0112), shared with cos-runner: D1 keeps a snippet only.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "cos-blobs" }],
  // OAuth 2.1 for /mcp (ADR 0021): clients, grants and hashed tokens. Provisioned by name on
  // first deploy, like the D1 database.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // The in-app assistant (ADR 0340): one AssistantAgent Durable Object per user (`user:<id>`),
  // on the Agents SDK, with SQLite storage for the thread and hibernatable WebSockets.
  "durable_objects": {
    "bindings": [
      { "name": "ASSISTANT", "class_name": "AssistantAgent" },
      // One object per agent (ADR 0344), named `job:<id>`: it deletes its storage when done.
      { "name": "AGENT_JOB", "class_name": "AgentJob" }
    ]
  },
  // The first step is tagged with the last of the history it replaced (ADR 0352): a new account
  // never had the per-conversation class of ADR 0200 that v1 created and v2 deleted.
  "migrations": [
    { "tag": "v2", "new_sqlite_classes": ["AssistantAgent"] },
    { "tag": "v3", "new_sqlite_classes": ["AgentJob"] }
  ],
  // Workers Rate Limiting (ADR 0056, docs/deploying.md). Limits are per Cloudflare location and
  // approximate; change them here and redeploy. namespace_id must be an integer unique within
  // the account: change these if another Worker in your account already uses them.
  "ratelimits": [
    // Every /mcp request, per connected app.
    { "name": "MCP_RATE_LIMIT", "namespace_id": "4101", "simple": { "limit": 120, "period": 60 } },
    // Non-read operations over MCP, per connected app.
    {
      "name": "MCP_WRITE_RATE_LIMIT",
      "namespace_id": "4102",
      "simple": { "limit": 30, "period": 60 }
    },
    // Code Mode runs, per user.
    {
      "name": "CODE_MODE_RATE_LIMIT",
      "namespace_id": "4103",
      "simple": { "limit": 10, "period": 60 }
    },
    // A customer's calls over the HTTP surface, per account and operation (stage 22, 23).
    {
      "name": "CUSTOMER_RATE_LIMIT",
      "namespace_id": "4104",
      "simple": { "limit": 60, "period": 60 }
    },
    // Customer sign-in code requests, per email address asked for (stage 22).
    {
      "name": "CUSTOMER_CODE_RATE_LIMIT",
      "namespace_id": "4105",
      "simple": { "limit": 3, "period": 60 }
    },
    // Customer sign-in code requests, per client address, keyed by a hash of it (stage 23).
    {
      "name": "CUSTOMER_CODE_ADDRESS_RATE_LIMIT",
      "namespace_id": "4106",
      "simple": { "limit": 10, "period": 60 }
    },
    // Customer sign-in codes sent to new addresses that only "anyone starting a subscription"
    // lets sign in, for the whole host: one key (ADR 0459).
    {
      "name": "CUSTOMER_CODE_NEW_RATE_LIMIT",
      "namespace_id": "4107",
      "simple": { "limit": 20, "period": 60 }
    },
    // A staff member's calendar feed (stage 45 step 5, ADR 0628): fetches per feed, keyed by a
    // hash of its token. A calendar app fetches every few minutes at most.
    {
      "name": "STAFF_FEED_RATE_LIMIT",
      "namespace_id": "4108",
      "simple": { "limit": 10, "period": 60 }
    },
    // Calendar feed fetches per client address, hashed, before any token is looked up. A
    // calendar provider fetches many people's feeds from a few addresses: room for a team.
    {
      "name": "STAFF_FEED_ADDRESS_RATE_LIMIT",
      "namespace_id": "4109",
      "simple": { "limit": 120, "period": 60 }
    },
    // A customer's calendar feed (stage 62 step 1, ADR 0890): fetches per feed, keyed by a hash of
    // its token, as the staff feed's. Its own namespace, so the two feeds never share a bucket.
    {
      "name": "CUSTOMER_FEED_RATE_LIMIT",
      "namespace_id": "4890",
      "simple": { "limit": 10, "period": 60 }
    },
    // Customer calendar feed fetches per client address, hashed, before any token is looked up.
    {
      "name": "CUSTOMER_FEED_ADDRESS_RATE_LIMIT",
      "namespace_id": "4891",
      "simple": { "limit": 120, "period": 60 }
    },
    // Calls to the desk origin (the enrolled tablet, ADR 0649) per client address: a tablet makes
    // a few a minute; codes and enrolment codes are guessed nowhere near fast enough.
    { "name": "DESK_RATE_LIMIT", "namespace_id": "4151", "simple": { "limit": 60, "period": 60 } },
    // Calls from outside the org to an operation open to the public, per client address (ADR
    // 0940, packages/core/src/public-limits.ts), keyed by a hash of the address (an IPv6 address
    // by its /64) and the operation. cos-runner binds the strict and shared ones with the same
    // namespaces, so a pack tool's order start counts in the same place.
    // standard: reads (120 a minute per address and operation).
    {
      "name": "PUBLIC_RATE_LIMIT",
      "namespace_id": "4110",
      "simple": { "limit": 120, "period": 60 }
    },
    // low: writes, order.quote and intake.open (30 a minute per address and operation).
    {
      "name": "PUBLIC_WRITE_RATE_LIMIT",
      "namespace_id": "4111",
      "simple": { "limit": 30, "period": 60 }
    },
    // strict: order starts, code checks, contact.stop, intake.submit (10 a minute per address and
    // group).
    {
      "name": "PUBLIC_STRICT_RATE_LIMIT",
      "namespace_id": "4112",
      "simple": { "limit": 10, "period": 60 }
    },
    // A client app's Worker that passes no visitor address (an older template): one bucket for
    // the client app per operation or group, never unlimited.
    {
      "name": "PUBLIC_SHARED_RATE_LIMIT",
      "namespace_id": "4113",
      "simple": { "limit": 1200, "period": 60 }
    }
  ],
  "vars": {
    // better-auth (default) or cloudflare-access. See docs/deploying.md.
    "IDENTITY_PROVIDER": "better-auth",
    // Only the first user may sign up unless this is "true".
    "AUTH_ALLOW_SIGNUP": "false",
    // Approval-policy floor (ADR 0011): JSON rules the org's preset can never loosen, e.g.
    // {"*":{"destructive":"review"}}. Empty means no floor. See docs/deploying.md.
    "APPROVAL_FLOOR": "",
    // Days before a pending action (an AI change waiting for approval) expires (ADR 0022).
    "APPROVAL_EXPIRY_DAYS": "7",
    // MCP rate limits are the `ratelimits` bindings above (ADR 0056).
    // MCP access token lifetime in seconds; refresh tokens last 30 days.
    "MCP_ACCESS_TOKEN_TTL": "3600",
    // Origins a browser may call the HTTP surface (/api/v1) from, comma separated, e.g. a client
    // app's site. Phones and servers send no origin and are not affected. Empty: none.
    "API_ALLOWED_ORIGINS": "",
    // The desk origin's hostname (stage 44 step 6, ADR 0649): `desk.` before the host's name, where
    // the business's enrolled tablet runs. `cos deploy` sets it with the custom domain; empty (a
    // workers.dev install, local dev without it): no desk signing and no enrolled devices. The
    // DESK_SECRET secret goes with it.
    "DESK_HOSTNAME": "",
    // Videos in Cloudflare Stream on this account (stage 42, ADR 0475; docs/stream-runbook.md).
    // The account id, its playback subdomain's code (customer-<code>.cloudflarestream.com) and the
    // signing key's id; the API token (STREAM_API_TOKEN) and the key's JWK (STREAM_SIGNING_JWK)
    // are secrets. Any left empty: video is not configured. Every video requires a signed token.
    "STREAM_ACCOUNT_ID": "",
    "STREAM_CUSTOMER_CODE": "",
    "STREAM_SIGNING_KEY_ID": "",
    // Hostnames a video may be played from, comma separated. Empty: the host's and the company's
    // web apps' (BETTER_AUTH_URL, CUSTOMER_AUTH_URL, API_ALLOWED_ORIGINS).
    "STREAM_ALLOWED_ORIGINS": "",
    // "true" in .dev.vars only: the fake Stream for local development. Never in a deployment.
    "STREAM_FAKE": "",
    // In-app AI (ADRs 0009, 0150-0155). Model roles need an `ai` binding and semantic search a
    // `vectorize` binding; both are optional and added by `pnpm run deploy` (COS_AI, see
    // docs/deploying.md). Without them AI features say AI is not configured.
    // AI Gateway id: every model call goes through it when set (usage and spend per role).
    "AI_GATEWAY_ID": "",
    // The Cloudflare account id: AI Gateway URLs for non-Workers-AI providers, and Settings → AI
    // (keys as Workers secrets, usage) together with the CLOUDFLARE_API_TOKEN secret.
    "CLOUDFLARE_ACCOUNT_ID": "",
    // Deploy-config layer of the model registry: JSON role → { provider, model, params, fallback }.
    // Empty means the shipped defaults (all Workers AI). A deployment sets it, e.g. with
    // `create-composable-os --model-roles deepseek-flash` (ADR 0192); never commit a choice here.
    "AI_MODEL_ROLES": "",
    // Base URLs for the `openai-compatible` provider: JSON { "<provider>": { "baseURL" } }.
    "AI_PROVIDERS": "",
    // "true": Workers AI goes over REST through the gateway with prompt and response logging off,
    // because AI_GATEWAY_TOKEN also holds Workers AI Read. Set by the installer and the updater
    // (ADR 0330); empty keeps Workers AI on the `ai` binding.
    "AI_GATEWAY_REST": "",
    // Providers whose key is stored in AI Gateway as BYOK, comma-separated (e.g. "deepseek").
    // Set by `create-composable-os --provider-key` (ADR 0192).
    "AI_GATEWAY_BYOK": "",
    // The judge (Jev, ADR 0230): "true" when AI Gateway holds TypeSafe's key as BYOK under
    // `custom-typesafe` (set by `create-composable-os --provider-key typesafe=…`). Otherwise the
    // key is the TYPESAFE_API_KEY secret; with neither, the judge is off.
    "JUDGE_BYOK": "",
    // Deploy layer of the judge's placement switches: JSON { "<placement>": true | false }, e.g.
    // '{"summary.statements":true}' to turn on a placement that sends record content. Empty: the
    // shipped defaults. Admins override it in Settings → AI.
    "JUDGE_PLACEMENTS": "",
    // Size of the Vectorize index (`cos-records`); the embed role must produce this many dims.
    "VECTORIZE_DIMENSIONS": "384",
    // Worker scripts Settings → AI stores provider keys on (as Workers secrets).
    "AI_SECRET_SCRIPTS": "cos-app,cos-runner",
    // Local dev and e2e only (.dev.vars sets it): "true" answers the build role with a
    // deterministic stand-in when there is no `ai` binding. Never set it in production.
    "AI_FAKE_MODEL": "",
    // Release (stage 8, ADR 0160): the installed release's version, set by the release manifest.
    // Empty means a source deploy (`pnpm run deploy`), which the self-updater cannot update.
    "COS_RELEASE_VERSION": "",
    // Where Settings → Updates reads releases from (public GitHub Releases, no telemetry). Empty
    // means the product's own repository (products/<id>/product.ts). Forks that publish their own
    // releases set it.
    "COS_RELEASE_REPO": "",
    // The Cloudflare account the self-updater deploys to. Filled in by the installer from the
    // release manifest's $ACCOUNT_ID placeholder; never committed.
    "COS_ACCOUNT_ID": "",
    // Hosted SaaS only (ADR 0212): the control plane's Ed25519 public key (raw 32 bytes,
    // base64url) that signs support-access tokens for /support/enter. Empty (self-hosted) means
    // there is no support access at all: the route is a 404.
    "COS_SUPPORT_PUBLIC_KEY": "",
    // Hosted SaaS only (ADR 0213 amendment), set by the control plane at provisioning; empty on a
    // self-hosted install, which uses AI_GATEWAY_ID above. The shared platform gateway and the
    // platform account: every Workers AI role becomes Platform AI, tagged with COS_TENANT_ID and
    // the plan. The platform token (AI_PLATFORM_TOKEN) is a secret.
    "AI_PLATFORM_GATEWAY_ID": "",
    "AI_PLATFORM_ACCOUNT_ID": "",
    "COS_TENANT_ID": "",
    // Hosted SaaS only (ADR 0250): the control plane's origin, for the signed deployment channel
    // (Settings → AI stores the customer's own keys through it). The key, COS_CONTROL_KEY, is a
    // secret.
    "COS_CONTROL_URL": ""
  }
}
