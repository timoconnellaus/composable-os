// cos-runner: runs extension code, automations and Workflows (ADR 0004). Reached by cos-app over a
// service binding. Self-contained and account-agnostic: no account or resource IDs are committed
// (ADR 0012); wrangler provisions the D1 database by name on first deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cos-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "allow_irrevocable_stub_storage"],
  // Internal only: cos-app reaches it through a service binding, never a public URL.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cos",
      "migrations_dir": "../../packages/db/migrations",
      "migrations_table": "core_migrations"
    }
  ],
  "workflows": [
    {
      "binding": "HELLO_WORKFLOW",
      "name": "cos-hello",
      "class_name": "HelloWorkflow"
    },
    // Stage 5 (ADR 0130): every automation run is one instance; its id is derived from the run's
    // idempotency key, so a duplicate event never starts a second run.
    {
      "binding": "AUTOMATION_WORKFLOW",
      "name": "cos-automation",
      "class_name": "AutomationWorkflow"
    }
  ],
  // Automation events (ADR 0130): cos-app and this Worker produce committed record changes and
  // approval decisions; this Worker consumes them and starts runs. Failed batches retry, then go
  // to the dead-letter queue.
  "queues": {
    "producers": [
      { "binding": "AUTOMATION_EVENTS", "queue": "cos-automation-events" },
      // A routine's messages (ADR 0343): cos-app consumes this and owns the person's thread.
      { "binding": "ROUTINE_DELIVERY", "queue": "cos-routine-delivery" }
    ],
    "consumers": [
      {
        "queue": "cos-automation-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "cos-automation-events-dlq"
      }
    ]
  },
  // Schedules and date-relative triggers (ADR 0130): every minute, evaluated in the automation
  // timezone (Settings → Automations). Cron triggers themselves are UTC.
  "triggers": { "crons": ["* * * * *"] },
  // Automation runs per minute, per automation (ADR 0130). Above it the automation auto-pauses
  // and admins are notified. namespace_id must be unique within the account.
  "ratelimits": [
    {
      "name": "AUTOMATION_RATE_LIMIT",
      "namespace_id": "4201",
      "simple": { "limit": 60, "period": 60 }
    },
    // The limits on public operations (ADR 0940): a pack tool's calls are counted per caller
    // (order starts, form answers, code checks), and code checks pass the host-wide surge rate
    // while wrong codes are over the ceiling. The same namespaces as cos-app's bindings of the
    // same names, so the two Workers share each count.
    {
      "name": "PUBLIC_CALLER_RATE_LIMIT",
      "namespace_id": "4112",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "PUBLIC_CODE_SURGE_RATE_LIMIT",
      "namespace_id": "4115",
      "simple": { "limit": 30, "period": 10 }
    }
  ],
  // Worker Loader: the Dynamic Workers that run extension code (ADR 0006). Repeat code (tools,
  // manifest evaluation, the type checker) uses LOADER.get with a stable id; only Code Mode
  // scripts use LOADER.load (ADR 0043).
  "worker_loaders": [{ "binding": "LOADER" }],
  // The extension workspace (ADR 0025, ADR 0043): extension source under git and the build cache.
  // It runs no code. CODE_MODE_GATE: one per user, Code Mode's concurrency limit of 1.
  "durable_objects": {
    "bindings": [
      { "name": "EXTENSION_WORKSPACE", "class_name": "ExtensionWorkspace" },
      { "name": "CODE_MODE_GATE", "class_name": "CodeModeGate" },
      // Stage 6a (ADR 0110): one integration host per connection. It owns gatekeeper accounts,
      // facets and hooks (persistent RPC stubs need allow_irrevocable_stub_storage).
      { "name": "INTEGRATION_HOST", "class_name": "IntegrationHost" },
      // The fake provider (development and tests only; see INTEGRATIONS_FAKE_PROVIDER).
      { "name": "FAKE_ACCOUNT", "class_name": "FakeAccount" },
      { "name": "FAKE_PROVIDER", "class_name": "FakeProvider" }
    ]
  },
  // One step, tagged with the last of the history it replaced (ADR 0352): a new account has none
  // of the classes that history created and deleted. Add new classes as v5 and on.
  "migrations": [
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "ExtensionWorkspace",
        "CodeModeGate",
        // Stage 6a: the integration host, and the fake gatekeeper (its facet class included).
        "IntegrationHost",
        "FakeAccount",
        "FakeProvider",
        "FakeGatekeeper"
      ]
    }
  ],
  // Email bodies of synced mail (ADR 0112): D1 keeps a snippet only (cost audit U1).
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "cos-blobs" }],
  // Gatekeepers (ADR 0007): each is a Worker's GatekeeperVendor entrypoint, enabled per
  // deployment by an admin. Deploy the gatekeeper Workers you use and add their bindings here
  // (GATEKEEPER_GOOGLE → cos-gatekeeper-google, …); see docs/integrations.md. The fake provider
  // is cos-runner itself and answers only when INTEGRATIONS_FAKE_PROVIDER is "true". It is local
  // only: deploy-inputs.json `devOnly` keeps it out of every deployment.
  "services": [
    { "binding": "GATEKEEPER_FAKE", "service": "cos-runner", "entrypoint": "FakeGatekeeperVendor" }
  ],
  "vars": {
    // Extension code calls operations here (codemode:ops), so the runner applies the same
    // approval floor as cos-app. Keep the two in step. See docs/deploying.md.
    "APPROVAL_FLOOR": "",
    // The packs this deployment installs ("*": every pack in the release; "": none) and the
    // sha256 of the org's own extensions in BLOBS, both set by `cos deploy` (stage 24, ADR 0422).
    "COS_PACKS": "*",
    "COS_ORG_EXTENSIONS": "",
    // codemode:ai and proposal summaries use the model role registry (ADR 0150), like cos-app:
    // keep these in step with apps/app/wrangler.jsonc. Workers AI needs an `ai` binding, added
    // by `pnpm run deploy` (COS_AI, docs/deploying.md).
    "AI_GATEWAY_ID": "",
    "CLOUDFLARE_ACCOUNT_ID": "",
    "AI_MODEL_ROLES": "",
    "AI_PROVIDERS": "",
    "AI_GATEWAY_BYOK": "",
    // Workers AI over REST through the gateway, payload logging off (ADR 0330); set by the installer.
    "AI_GATEWAY_REST": "",
    // The judge (Jev, ADR 0230), as on cos-app: keep these in step with apps/app/wrangler.jsonc.
    "JUDGE_BYOK": "",
    "JUDGE_PLACEMENTS": "",
    // Hosted SaaS only (ADR 0213 amendment), set at provisioning: Platform AI through the shared
    // gateway, tagged with the tenant. Keep in step with apps/app/wrangler.jsonc.
    "AI_PLATFORM_GATEWAY_ID": "",
    "AI_PLATFORM_ACCOUNT_ID": "",
    "COS_TENANT_ID": "",
    // The CRM's public origin (https://crm.example.com), where connect popups are handed back.
    // cos-app passes the request's origin; this is the fallback.
    "APP_ORIGIN": "",
    // "true" offers the fake provider (development and e2e only; never in production).
    "INTEGRATIONS_FAKE_PROVIDER": "false"
  }
}
