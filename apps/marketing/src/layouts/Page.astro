---
// The shell for every page: metadata, self-hosted fonts, the icon sprite, and the frame that holds
// the header, the page and the footer. It
// loads nothing from another origin (no fonts, scripts, analytics or embeds), which
// scripts/check-static.mjs enforces.
import Fonts from "../components/Fonts.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Sprite from "../components/Sprite.astro";
import "../styles/base.css";

interface Props {
  title?: string;
  description?: string;
  /** True on the landing page itself (in-page header links). */
  home?: boolean;
  /** Keep the page out of search results (form results, 404). */
  noindex?: boolean;
}
const {
  title = "Custom business software, with a head start · Composable OS",
  description = "Zero BS AI builds custom software to fit your business on Composable OS, from parts that already work, then looks after it on one subscription. Book a call.",
  home = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#eaf3fe" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content="Composable OS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Composable OS: a head start on custom software to fit your business." />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Marks that JavaScript runs, before first paint, so no-JS styles never flash. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <Fonts />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Sprite />
    <div class="frame">
      <Header home={home} />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
