---
// The sticky header: a short menu and the page's one action. On the landing page the links are
// in-page anchors; elsewhere they lead back to it. Below 980px the links move into a menu
// (site.ts); the action stays in the bar at every width, with or without JavaScript.
import { CTA } from "../links.ts";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

interface Props {
  /** True on the landing page itself. */
  home?: boolean;
  /** True on a page with its own call form (#call), so the action stays on the page. */
  call?: boolean;
}
const { home = false, call = home } = Astro.props;
const at = (hash: string) => (home ? hash : `/${hash}`);
const links = [
  { href: at("#how"), label: "How it works" },
  { href: at("#pieces"), label: "What can go in" },
  { href: at("#solutions"), label: "Solutions" },
  { href: at("#care"), label: "Looked after" },
  { href: at("#developers"), label: "For developers" },
];
---

<header class="site" id="top">
  <div class="wrap nav">
    <a class="logo" href={home ? "#top" : "/"}><Logo /><span class="logo-name">Composable OS</span></a>
    <nav class="links" aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a class="btn dark sm" href={call ? "#call" : "/#call"}>{CTA}</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mm" aria-label="Open menu">
      <Icon name="menu" />
    </button>
  </div>
  <nav class="mobile-menu" id="mm" aria-label="Menu">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</header>
