---
// Self-hosted Poppins (OFL, from @fontsource/poppins): latin subset, the four weights the page
// uses, font-display: swap. The two the hero needs are preloaded. Nothing is fetched from another
// origin.
import w400 from "@fontsource/poppins/files/poppins-latin-400-normal.woff2?url";
import w500 from "@fontsource/poppins/files/poppins-latin-500-normal.woff2?url";
import w600 from "@fontsource/poppins/files/poppins-latin-600-normal.woff2?url";
import w700 from "@fontsource/poppins/files/poppins-latin-700-normal.woff2?url";

const LATIN =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";

const faces = [
  { weight: 400, url: w400 },
  { weight: 500, url: w500 },
  { weight: 600, url: w600 },
  { weight: 700, url: w700 },
];

const css = faces
  .map(
    (face) =>
      `@font-face{font-family:"Poppins";font-style:normal;font-display:swap;font-weight:${face.weight};src:url(${face.url}) format("woff2");unicode-range:${LATIN}}`,
  )
  .join("");
---

<link rel="preload" href={w700} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={w400} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css}></style>
