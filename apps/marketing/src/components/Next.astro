---
// Products that are designed and not built. Said plainly, so nobody reads them as available.
import Icon from "./Icon.astro";

const next = [
  {
    icon: "task",
    title: "Ticketing",
    body: "Events, ticket types, checkout and door scanning, for a company that sells its own tickets.",
  },
  {
    icon: "grid",
    title: "Content",
    body: "Pages and posts with drafts, preview and publishing, on the same records and approvals.",
  },
];
---

<section class="tight-top" aria-labelledby="next-title">
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">In design</span>
      <h2 id="next-title">Next: products for one company at a time.</h2>
      <p class="lead">
        The same host can carry software that only one company needs. These are being designed in
        the open and are not built yet.
      </p>
    </div>
    <div class="features">
      {
        next.map((item) => (
          <div class="feature glass reveal">
            <div class="ic">
              <Icon name={item.icon} />
            </div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
