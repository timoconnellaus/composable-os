---
// What the host gives every product. Each line is something built and in the repository today.
import Icon from "./Icon.astro";

const parts = [
  {
    icon: "flow",
    title: "One set of operations",
    body: "Everything a person can do is an operation with a schema, a permission and a risk level. The app, your AI and extension code all call the same ones.",
  },
  {
    icon: "inbox",
    title: "Approvals in front of AI",
    body: "Changes an AI wants to make wait in an inbox as a change set you can read and test. Admins set what may run without asking.",
  },
  {
    icon: "bolt",
    title: "Extensions written by AI",
    body: "New objects, fields, dashboards and automations are code. It is type-checked, shown to you as a diff, and run in a sandbox with no network.",
  },
  {
    icon: "mail",
    title: "Connections you control",
    body: "Email, calendars, Slack and other systems are reached only through gatekeepers, each limited to what you connected and allowed.",
  },
  {
    icon: "pulse",
    title: "An audit log of everything",
    body: "Every action by a person, an automation or an AI is recorded with who asked for it and why. Erasing a person removes them from every store.",
  },
  {
    icon: "home",
    title: "Your account, your data",
    body: "One deployment per organisation, on Workers, D1 and R2 in your own Cloudflare account. The installer sets it up and updates it when you choose.",
  },
];
---

<section id="platform" aria-labelledby="platform-title">
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">The platform</span>
      <h2 id="platform-title">The hard parts are built once, for every product.</h2>
      <p class="lead">
        A product is a named composition on the host: which objects and rules it has, what it is
        called, and the screens people use. What keeps it safe is the same underneath each one.
      </p>
    </div>
    <div class="features">
      {
        parts.map((part) => (
          <div class="feature glass reveal">
            <div class="ic">
              <Icon name={part.icon} />
            </div>
            <h3>{part.title}</h3>
            <p>{part.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
