---
// The toolkit, for developers and agencies: the second part of the offer, kept to one section.
// The commands match docs/deploying.md ("A company's own product"), docs/importing.md (the import
// commands) and the start-client-app, add-block and import-content skills. Update them together.
import { REPO_URL } from "../links.ts";
import Icon from "./Icon.astro";
import Text from "./Text.astro";

const checks = [
  "Source available, free to self-host",
  "Skills that teach your coding agent to write extensions",
  "Workers, D1 and R2 on Cloudflare, with no servers to manage",
];

// One line each; a "#" line is a comment. Each is its own block, so on a phone a long command
// wraps between words (never inside "--label"), with a hanging indent, instead of scrolling out
// of sight.
const lines = [
  "# start a company's own product",
  'npm create composable-os harbour -- --label "Harbour Roasters"',
  "cd harbour",
  "pnpm cos add web-sign-in",
  "pnpm cos deploy",
  "# the host and the web app, in a Cloudflare account",
  "pnpm cos content import ./old-blog --host https://admin.example.com",
  "# posts and pictures from the old blog; cos courses import, cos subscriptions offers import and cos rostering import do the same for courses, subscribers and the roster",
];
---

<section id="developers" class="tint dev" aria-labelledby="developers-title">
  <div class="wrap split">
    <div class="reveal">
      <span class="eyebrow">For developers and agencies</span>
      <h2 id="developers-title">Or build on it yourself.</h2>
      <p class="lead">
        Composable OS is the same toolkit we use. Start a client product from the template, choose
        its packs, and deploy it to a Cloudflare account.
      </p>
      <ul class="checks">
        {
          checks.map((check) => (
            <li>
              <Icon name="check" />
              <span>
                <Text text={check} />
              </span>
            </li>
          ))
        }
      </ul>
      <a class="textlink" href={REPO_URL}>Read the docs on GitHub</a>
    </div>
    {/* Inside <pre> every space and newline shows, so the lines are written without any. */}
    <pre class="term reveal" tabindex="0" role="region" aria-label="Commands to start a product"><code>{lines.map((line) => line.startsWith("#") ? <span class="l c">{line}</span> : <span class="l"><span class="p">$ </span>{line.split(" ").map((word, i) => <>{i > 0 && " "}<span class="w">{word}</span></>)}</span>)}</code></pre>
  </div>
</section>
