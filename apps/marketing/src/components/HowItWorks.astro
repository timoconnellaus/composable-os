---
import { CTA } from "../links.ts";

const steps = [
  {
    title: "Tell us how you work",
    body: "What you sell, who does what, and where the spreadsheets are.",
  },
  {
    title: "We compose your product",
    body: "Your records, your rules and your screens, on parts that already work.",
  },
  {
    title: "We look after it",
    body: "One subscription covers hosting, fixes, support, and changes as your business changes.",
  },
];
---

<section id="how" class="tint" aria-labelledby="how-title">
  <div class="wrap split">
    <div class="reveal">
      <span class="eyebrow">How it works</span>
      <h2 id="how-title">We start from how your business runs, not from a blank page.</h2>
      <p class="lead">
        The parts every business product needs are already built. The work is choosing them and
        shaping them around you.
      </p>
      <a class="btn" href="#call">{CTA}</a>
    </div>
    <ol class="steps">
      {
        steps.map((step, i) => (
          <li class="card reveal">
            <span class="n" aria-hidden="true">
              {i + 1}
            </span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
