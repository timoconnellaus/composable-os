---
// What can go into a company's product. Each line is true of the repository today, and each status
// word means what apps/marketing/SITE.md says it means: "Customers and sales" is the base records
// plus the Deals and Leads packs, ready today; Ticketing, Content, Programs and Courses are packs
// that are built and merged (stages 27, 28, 41 and 42) but have not run for a customer yet, and
// say so. Courses' monthly subscription (stage 32a step 3) and moving subscribers from another
// platform (continuation offers, step 4) are built too, with the rest of the card. Bookings is
// being built: its spine (stage 31a step 3: the timetable, booking and cancelling within each
// class type's rules, staff bookings), spending a membership's use and the waitlist (steps 4
// and 5), parents booking for their children (step 6, the family link), attendance, moves
// and cancelling a class (step 7), drop-ins (step 8), and the emails with their calendar file and
// the reminder, the dashboard and the coach's list in the app (step 9) are merged; the import
// (step 10) and one-to-one sessions (31b) are not yet. Its staff screens on the web (the front desk
// and the class list) are built, but the product's admin does not show them yet. Memberships (stage 32b) is
// being built: its plans, memberships and passes, spent by bookings (step 6), plan changes, staff
// pauses and its dashboard (steps 6 and 7) are merged; the import of members (step 8) is not yet.
// Rostering (stage 45) is being built: the host's rules for shifts (steps 1 to 3: one person never
// on two shifts at once, warnings, offers and takes, time off) and the pack's duties, weekly
// patterns and tools (step 4), pay (step 6), the calendar feed (step 5) and the screens on the web
// and in the app (step 7, not yet tried on phones; the product's admin does not show the web
// screens yet) are merged; checklists (step 4b) are not yet.
// Agreements (stage 44) is being built: documents and versions (step 1), acceptances (step 2),
// the check before paying, subscribing and booking (step 3), the copy and the signed PDF (step 4)
// the screens on the web and in the app (step 5) and cooling off (step 7) are merged; signing at
// the desk (step 6) is not yet.
// The last card is the piece built only for this business.
import { STATUS } from "../status.ts";
import Icon from "./Icon.astro";

const BUILT = STATUS.built;
const BUILDING = STATUS.building;

const pieces = [
  {
    icon: "users",
    title: "Customers and sales",
    body: "People, organisations, deals and leads, with pipelines and email on the timeline. Ready today.",
  },
  {
    soon: BUILT,
    title: "Ticketing",
    body: "Events, ticket types, checkout in full or by deposit, tickets in your app and door scanning.",
  },
  {
    soon: BUILT,
    title: "Content",
    body: "Blog posts with drafts, preview links, scheduled publishing and pictures. Your old posts come across with an import.",
  },
  {
    soon: BUILT,
    title: "Programs",
    body: "Training programs built from your exercise bank, given to a person or a class, with every set logged on the web and in the app.",
  },
  {
    soon: BUILT,
    title: "Courses",
    body: "Video lessons sold one at a time, in bundles or by a monthly subscription with a free trial, with progress, and only those who hold them can play them. Members cancel and update their card on the web. Subscribers moving from another platform continue free until the date they have already paid up to.",
  },
  {
    soon: BUILDING,
    title: "Bookings",
    body: "Classes made from a weekly timetable, booked and cancelled on the web and in the app within each class type's rules: when booking opens and closes, and when a cancel is late. A full class has a waiting list that moves people in on their own. Parents book for their children. A visitor pays for a single class on the website, no account needed, their place held while they pay. Staff book anyone, walk-ins too, move a member to another class and cancel a class before it ends, giving back the class of everyone on it who booked with a membership or pass, even those already ticked or who cancelled late, and refunding to the card anyone who paid for that class on the website once a member of staff approves it. Members are emailed when they book, when the gym changes or cancels their class, and with a reminder before it, with a file that adds the class to their calendar, by default staff approve each one until the gym turns automatic emails on. Coaches tick who came in the app. The front desk and class-list screens are built for the web too, where the product's admin does not show them yet.",
  },
  {
    soon: STATUS.building,
    title: "Memberships",
    body: "Monthly memberships, unlimited or a number of classes a week or month, and passes bought once: class packs that expire, drop-ins and an intro offer, one per person. Members see what they have left, used up as they book classes, and change plan on the web; staff pause a membership for a set time.",
  },
  {
    soon: STATUS.building,
    title: "Rostering",
    body: "Who works each class and each shift that is not a class, like cleaning. A weekly pattern makes the shifts eight weeks ahead, nobody is ever put on two at once, and staff say when they are away and offer a shift they cannot work for a qualified colleague to take, with the manager told. Hours and classes are totalled per pay period for the staff paid by them and locked, with a file for payroll; no pay rates are kept. Each person's own shifts are published at a private calendar address only they get, from their own calendar screen. The screens are built for the app (not yet tried on phones) and for the web, where the product's admin does not show them yet; the calendar address is not yet tried in phone calendars.",
  },
  {
    soon: STATUS.building,
    title: "Agreements",
    body: "Terms, waivers, health questions and a parent's consent, written by the business and agreed to on the web or in the app, with a typed name or a drawn signature. Visitors agree on the way to paying, parents agree for their children, and nobody books a class or buys a membership or pass without agreeing first. A copy goes by email to whoever agrees online, and the business can download the signed PDF at any time. The app's screens are built but not yet tried on phones. The business can set a cooling-off period: a new member can end their membership on the website inside it, once, and what they paid in that period is refunded once a member of staff approves it (not for members moving over from another system). Still to come: signing on the business's own tablet at the desk.",
  },
];
---

<section id="pieces" aria-labelledby="pieces-title">
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">What can go in</span>
      <h2 id="pieces-title">Take the pieces your business needs. Leave the rest.</h2>
      <p class="lead">
        Each piece works with the others, on the same records and rules. Yours might be one of
        them, all of them, or mostly something nobody else has.
      </p>
    </div>
    <div class="grid">
      {
        pieces.map((piece) => (
          <div class="card reveal">
            {piece.soon ? (
              <span class="soon">{piece.soon}</span>
            ) : (
              <div class="ic">
                <Icon name={piece.icon ?? "grid"} />
              </div>
            )}
            <h3>{piece.title}</h3>
            <p>{piece.body}</p>
          </div>
        ))
      }
      <div class="card own reveal">
        <h3>The part only you have</h3>
        <p>The thing no subscription does the way you do it. We build that piece for you.</p>
      </div>
    </div>
  </div>
</section>
