// The top of the page: what Composable OS is, and the two things a visitor can do next.
---

<section class="hero" aria-labelledby="hero-title">
  <div class="orb" aria-hidden="true"></div>
  <div class="orb s" aria-hidden="true"></div>
  <div class="wrap">
    <span class="eyebrow">A platform for company software</span>
    <h1 id="hero-title">
      Compose the software <span class="chrome-text">your company runs on.</span>
    </h1>
    <p class="lead">
      Composable OS is a trusted host that runs in your own Cloudflare account. Products are
