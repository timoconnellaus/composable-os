---
import { QUESTIONS } from "../faq.ts";
import Icon from "./Icon.astro";
---

<section class="questions" aria-labelledby="faq-title">
  <div class="wrap">
    <h2 id="faq-title" class="reveal">Questions</h2>
    <div class="faq">
      {
        QUESTIONS.map((item, i) => (
          <details open={i === 0}>
            <summary>
              {item.q}
              <Icon name="plus" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
