---
// The questions: the home page's (faq.ts) unless a page passes its own. The page that shows them
// also writes them as FAQPage structured data, from the same list.
import { QUESTIONS } from "../faq.ts";
import Icon from "./Icon.astro";

interface Props {
  questions?: readonly { q: string; a: string }[];
}
const { questions = QUESTIONS } = Astro.props;
---

<section class="questions" aria-labelledby="faq-title">
  <div class="wrap">
    <h2 id="faq-title" class="reveal">Questions</h2>
    <div class="faq">
      {
        questions.map((item, i) => (
          <details open={i === 0}>
            <summary>
              {item.q}
              <Icon name="plus" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
