---
// The Composable OS site (composableos.dev): Zero BS AI builds a company's own software on the
// platform and looks after it. One page, one action (book a call), one section per component.
// SITE.md says what each section claims; keep it true when this page changes.
import Care from "../components/Care.astro";
import Control from "../components/Control.astro";
import Developers from "../components/Developers.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Inside from "../components/Inside.astro";
import Pieces from "../components/Pieces.astro";
import Problem from "../components/Problem.astro";
import { QUESTIONS } from "../faq.ts";
import Page from "../layouts/Page.astro";
import "../styles/landing.css";

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: QUESTIONS.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
});
---

<Page home>
  <script type="application/ld+json" slot="head" is:inline set:html={faqSchema} />
  <Hero />
  <Problem />
  <HowItWorks />
  <Pieces />
  <Inside />
  <Care />
  <Control />
  <Developers />
  <Faq />
  <FinalCta />
</Page>
